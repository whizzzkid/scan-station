# scan-station environment variables
#
# Copy this file and fill in your values.
# Docker Compose reads this automatically.

# Timezone
TZ=Etc/UTC

# Scan settings (optional — these are the defaults)
# SCAN_VENDOR=fujitsu
# SCAN_DPI=300
# SCAN_MODE=Color
# SCAN_FILE_PREFIX=scan

# Host path where scanned PDFs are saved
SCAN_OUTPUT_PATH=./scans

# Backend secrets (fill in only the backends you use)

# Papra
# PAPRA_API_KEY=your-papra-api-key

# Paperless-NGX
# PAPERLESS_TOKEN=your-paperless-token

# S3 / MinIO
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
